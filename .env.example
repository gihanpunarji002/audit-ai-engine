# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Firebase & Google Cloud Configuration
# Option A: Path to serviceAccountKey.json (Recommended for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Direct credentials via environment variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Storage Bucket (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Authentication & JWT Configuration
JWT_SECRET=super_secret_jwt_key_please_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Local Temporary File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Cloud Firestore KNN & RAG Settings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
